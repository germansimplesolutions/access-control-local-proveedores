{
  "name": "face-id-proveedores",
  "productName": "Face ID Proveedores",
  "version": "1.0.0",
  "description": "Face ID Proveedores - control de acceso (SimpleAcceso)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist:win": "npm run prepare-app && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "digest-fetch": "^3.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "formidable": "^3.5.0",
    "get-content": "^1.0.2",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "node-json-db": "^2.2.0",
    "request-digest": "^1.0.13",
    "socket.io": "^4.7.2",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.simpleacceso.calocal.proveedores",
    "productName": "Face ID Proveedores",
    "publish": [
      {
        "provider": "github",
        "owner": "germansimplesolutions",
        "repo": "access-control-local-proveedores",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist-installer",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/**/*",
      "backend/**/*",
      "!backend/README.md"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Face ID Proveedores",
      "artifactName": "Face-ID-Proveedores-Setup-${version}.${ext}"
    }
  },
  "author": "SimpleSolutions"
}